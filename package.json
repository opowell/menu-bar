{
  "name": "menu-bar",
  "version": "0.1.0",
  "description": "An application menu bar for Vue 3: a row of names, each opening a menu of any depth, driven by plain data.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preversion": "npm run lint && npm run typecheck && npm run build",
    "version": "npm run build && git add dist",
    "release": "git push origin main --follow-tags"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "themes": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "themes": "github:opowell/themes#v0.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.4.5",
    "vue": "^3.5.44",
    "vue-tsc": "^2.2.0"
  },
  "keywords": [
    "vue",
    "vue3",
    "menu",
    "menubar",
    "dropdown"
  ]
}
